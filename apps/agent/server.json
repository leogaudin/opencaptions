{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.leogaudin/opencaptions",
  "title": "OpenCaptions",
  "description": "Animated word-by-word captions for your videos, made on your own OpenCaptions server",
  "websiteUrl": "https://docs.opencaptions.app/guides/agents/",
  "repository": {
    "url": "https://github.com/leogaudin/opencaptions",
    "source": "github",
    "subfolder": "apps/agent"
  },
  "version": "1.2.1",
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "opencaptions",
      "version": "1.2.1",
      "transport": { "type": "stdio" },
      "packageArguments": [{ "type": "positional", "value": "mcp" }],
      "environmentVariables": [
        {
          "name": "OPENCAPTIONS_KEY",
          "description": "An API key from your OpenCaptions server's Account page",
          "isRequired": true,
          "isSecret": true
        },
        {
          "name": "OPENCAPTIONS_URL",
          "description": "Your OpenCaptions server's web address",
          "default": "http://localhost:5173"
        }
      ]
    }
  ]
}
