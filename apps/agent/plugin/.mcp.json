{
  "mcpServers": {
    "opencaptions": {
      "command": "npx",
      "args": ["-y", "opencaptions@1.3.4", "mcp"],
      "env": {
        "OPENCAPTIONS_URL": "${OPENCAPTIONS_URL:-}",
        "OPENCAPTIONS_KEY": "${OPENCAPTIONS_KEY:-}",
        "OPENCAPTIONS_FFMPEG": "${OPENCAPTIONS_FFMPEG:-}"
      }
    }
  }
}
