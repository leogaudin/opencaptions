        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantiene tutta la luminosità e i colori dell’originale. Salvato in HEVC."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохраняет всю яркость и цвета оригинала. Сохраняется как HEVC."
