    "About a third smaller. Plays on recent phones and computers, not on some old players and sites.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Environ un tiers plus petit. Compatible avec les téléphones et ordinateurs récents, pas avec certains anciens lecteurs et sites."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aproximadamente un tercio más pequeño. Se reproduce en teléfonos y ordenadores recientes, no en algunos reproductores y sitios antiguos."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Etwa ein Drittel kleiner. Läuft auf aktuellen Telefonen und Computern, nicht auf manchen alten Playern und Websites."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Około jedną trzecią mniejszy. Działa na nowszych telefonach i komputerach, nie na niektórych starych odtwarzaczach i stronach."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cerca de um terço menor. Funciona em celulares e computadores recentes, não em alguns players e sites antigos."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Circa un terzo più piccolo. Funziona su telefoni e computer recenti, non su alcuni vecchi lettori e siti."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Примерно на треть меньше. Работает на новых телефонах и компьютерах, но не на некоторых старых плеерах и сайтах."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yaklaşık üçte bir daha küçük. Yeni telefon ve bilgisayarlarda oynar, bazı eski oynatıcı ve sitelerde oynamaz."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "約3分の1小さくなります。新しいスマートフォンやPCで再生でき、一部の古いプレーヤーやサイトでは再生できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "약 3분의 1 작습니다. 최신 휴대폰과 컴퓨터에서 재생되며, 일부 오래된 플레이어와 사이트에서는 재생되지 않습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "体积约小三分之一。可在较新的手机和电脑上播放，部分旧播放器和网站不支持。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sekitar sepertiga lebih kecil. Dapat diputar di ponsel dan komputer terbaru, tidak di beberapa pemutar dan situs lama."
          }
        }
      }
    },
