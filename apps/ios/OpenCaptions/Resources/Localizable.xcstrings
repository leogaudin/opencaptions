    "Open source (AGPL-3.0). Uses Whisper models and WhisperKit (MIT) and the Inter font (SIL OFL).": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Open source (AGPL-3.0). Utilise les modèles Whisper, WhisperKit (MIT) et la police Inter (SIL OFL)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Código abierto (AGPL-3.0). Usa los modelos Whisper, WhisperKit (MIT) y la fuente Inter (SIL OFL)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Source (AGPL-3.0). Nutzt Whisper-Modelle, WhisperKit (MIT) und die Schrift Inter (SIL OFL)."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Open source (AGPL-3.0). Używa modeli Whisper, WhisperKit (MIT) i czcionki Inter (SIL OFL)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Código aberto (AGPL-3.0). Usa modelos Whisper, WhisperKit (MIT) e a fonte Inter (SIL OFL)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Open source (AGPL-3.0). Usa i modelli Whisper, WhisperKit (MIT) e il carattere Inter (SIL OFL)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Открытый код (AGPL-3.0). Использует модели Whisper, WhisperKit (MIT) и шрифт Inter (SIL OFL)."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Açık kaynak (AGPL-3.0). Whisper modellerini, WhisperKit'i (MIT) ve Inter yazı tipini (SIL OFL) kullanır."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オープンソース（AGPL-3.0）。Whisperモデル、WhisperKit（MIT）、Interフォント（SIL OFL）を使用しています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오픈 소스(AGPL-3.0). Whisper 모델, WhisperKit(MIT), Inter 글꼴(SIL OFL)을 사용합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开源（AGPL-3.0）。使用 Whisper 模型、WhisperKit（MIT）和 Inter 字体（SIL OFL）。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sumber terbuka (AGPL-3.0). Memakai model Whisper, WhisperKit (MIT), dan font Inter (SIL OFL)."
          }
        }
      }
    },
