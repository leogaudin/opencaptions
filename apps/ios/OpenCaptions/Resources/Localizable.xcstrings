    "Choose “My server” to transcribe on another OpenCaptions server instead, which is faster on a computer with a graphics card.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez « Mon serveur » pour transcrire sur un autre serveur OpenCaptions, plus rapide sur un ordinateur doté d’une carte graphique."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige «Mi servidor» para transcribir en otro servidor OpenCaptions, más rápido en un ordenador con tarjeta gráfica."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle „Mein Server“, um auf einem anderen OpenCaptions-Server zu transkribieren, was auf einem Computer mit Grafikkarte schneller geht."
          }
        }
      }
    },
