    "You are on cellular or a hotspot. A Wi‑Fi connection would avoid using your data.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous êtes en données mobiles ou sur un point d’accès. Une connexion Wi‑Fi éviterait d’utiliser vos données."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estás con datos móviles o en un punto de acceso. Una conexión Wi‑Fi evitaría gastar tus datos."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du nutzt Mobilfunk oder einen Hotspot. Mit WLAN würden deine Daten geschont."
          }
        }
      }
    },
    "Your projects are kept. Saving a project again makes its video again.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
