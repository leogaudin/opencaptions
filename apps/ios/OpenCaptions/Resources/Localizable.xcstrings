    "Models are downloaded once and run on this device. Delete the ones you do not use to free space.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les modèles sont téléchargés une fois et fonctionnent sur cet appareil. Supprimez ceux que vous n’utilisez pas pour libérer de l’espace."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los modelos se descargan una vez y se ejecutan en este dispositivo. Elimina los que no uses para liberar espacio."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Modelle werden einmal geladen und laufen auf diesem Gerät. Lösche die, die du nicht nutzt, um Platz zu schaffen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Modele pobiera się raz i działają na tym urządzeniu. Usuń te, których nie używasz, aby zwolnić miejsce."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os modelos são baixados uma vez e rodam neste dispositivo. Exclua os que você não usa para liberar espaço."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I modelli si scaricano una volta e girano su questo dispositivo. Elimina quelli che non usi per liberare spazio."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Модели скачиваются один раз и работают на этом устройстве. Удалите ненужные, чтобы освободить место."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Modeller bir kez indirilir ve bu cihazda çalışır. Yer açmak için kullanmadıklarınızı silin."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "モデルは一度ダウンロードするとこのデバイスで動作します。使わないものは削除して空き容量を増やしましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모델은 한 번 다운로드하면 이 기기에서 실행됩니다. 사용하지 않는 모델은 삭제해서 공간을 확보하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "模型只需下载一次，并在此设备上运行。删除不用的模型可释放空间。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Model diunduh sekali dan berjalan di perangkat ini. Hapus yang tidak dipakai untuk mengosongkan ruang."
          }
        }
      }
    },
