    "Transcribe, restyle and **save** a video, all on this phone.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Transcrivez, stylisez et **enregistrez** une vidéo, le tout sur ce téléphone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Transcribe, da estilo y **guarda** un vídeo, todo en este teléfono."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Transkribiere, gestalte und **sichere** ein Video, alles auf diesem Telefon."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Transkrybuj, stylizuj i **zapisuj** wideo, wszystko na tym telefonie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Transcreva, estilize e **salve** um vídeo, tudo neste celular."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trascrivi, personalizza e **salva** un video, tutto su questo telefono."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Расшифровывайте, оформляйте и **сохраняйте** видео, всё на этом телефоне."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir videoyu çevirin, biçimlendirin ve **kaydedin**, hepsi bu telefonda."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "動画の文字起こし、スタイル変更、**保存**まで、すべてこのスマートフォンで。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "동영상을 받아쓰고, 스타일을 바꾸고, **저장**까지, 모두 이 휴대폰에서."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "转写、设计样式并**保存**视频，全部在这部手机上完成。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Transkripsikan, ubah gaya, dan **simpan** video, semua di ponsel ini."
          }
        }
      }
    },
