          }
        }
      }
    },
    "The audio of a video is sent to %@ to be transcribed, and deleted there afterwards.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’audio d’une vidéo est envoyé à %@ pour être transcrit, puis supprimé là-bas."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El audio de un vídeo se envía a %@ para transcribirlo y después se elimina allí."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Ton eines Videos wird zur Transkription an %@ gesendet und dort danach gelöscht."
          }
        }
      }
    },
    "The audio of your videos will be sent to %@ to be transcribed there. Only continue if you trust it.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’audio de vos vidéos sera envoyé à %@ pour y être transcrit. Ne continuez que si vous lui faites confiance."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El audio de tus vídeos se enviará a %@ para transcribirlo allí. Continúa solo si confías en él."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Ton deiner Videos wird zur Transkription an %@ gesendet. Fahre nur fort, wenn du ihm vertraust."
          }
        }
      }
    },
    "The clipboard does not hold an OpenCaptions link.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le presse-papiers ne contient pas de lien OpenCaptions."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El portapapeles no contiene un enlace de OpenCaptions."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Zwischenablage enthält keinen OpenCaptions-Link."
          }
        }
      }
    },
    "The font list could not be loaded.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La liste des polices n’a pas pu être chargée."
