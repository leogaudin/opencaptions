    "What the transcribe sheet starts with. Auto-detect works best on clear speech.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La langue proposée au départ dans la feuille de transcription. La détection automatique fonctionne mieux sur une voix claire."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con lo que empieza la hoja de transcripción. La detección automática funciona mejor con voz clara."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Womit das Transkriptionsblatt startet. Die automatische Erkennung funktioniert bei klarer Sprache am besten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Od czego zaczyna się arkusz transkrypcji. Automatyczne wykrywanie działa najlepiej przy wyraźnej mowie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Com o que a tela de transcrição começa. A detecção automática funciona melhor com fala clara."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Con cosa parte la schermata di trascrizione. Il rilevamento automatico funziona meglio con un parlato chiaro."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "С чего начинается окно расшифровки. Автоопределение лучше работает с чёткой речью."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çeviriyazı ekranının başlangıç değeri. Otomatik algılama net konuşmada en iyi çalışır."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "文字起こし画面の初期設定です。自動検出は明瞭な音声でいちばんよく働きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "받아쓰기 화면의 기본값입니다. 자동 감지는 또렷한 음성에서 가장 잘 작동합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "转写界面的默认设置。自动检测对清晰的语音效果最好。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilihan awal layar transkripsi. Deteksi otomatis bekerja paling baik pada ucapan yang jelas."
          }
        }
      }
    },
