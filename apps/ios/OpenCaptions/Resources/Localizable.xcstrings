    "Auto-detect works best on clear speech. If it guesses wrong, choose the language.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La détection automatique fonctionne mieux sur une voix claire. Si elle se trompe, choisissez la langue."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La detección automática funciona mejor con voz clara. Si se equivoca, elige el idioma."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die automatische Erkennung funktioniert bei klarer Sprache am besten. Rät sie falsch, wähle die Sprache."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatyczne wykrywanie działa najlepiej przy wyraźnej mowie. Jeśli się pomyli, wybierz język."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A detecção automática funciona melhor com fala clara. Se errar, escolha o idioma."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il rilevamento automatico funziona meglio con un parlato chiaro. Se sbaglia, scegli la lingua."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Автоопределение лучше работает с чёткой речью. Если ошибётся, выберите язык."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Otomatik algılama net konuşmada en iyi çalışır. Yanılırsa dili seçin."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自動検出は明瞭な音声でいちばんよく働きます。間違えたときは言語を選んでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자동 감지는 또렷한 음성에서 가장 잘 작동합니다. 틀리면 언어를 직접 선택하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动检测对清晰的语音效果最好。如果判断有误，请手动选择语言。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Deteksi otomatis bekerja paling baik pada ucapan yang jelas. Jika salah, pilih bahasanya."
          }
        }
      }
    },
