    "OpenCaptions needs permission to add to Photos. You can allow it in Settings.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenCaptions a besoin de l’autorisation d’ajouter à Photos. Vous pouvez l’accorder dans Réglages."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenCaptions necesita permiso para añadir a Fotos. Puedes permitirlo en Ajustes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenCaptions braucht die Erlaubnis, Fotos hinzuzufügen. Du kannst sie in den Einstellungen erteilen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenCaptions potrzebuje zgody na dodawanie do Zdjęć. Możesz ją nadać w Ustawieniach."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O OpenCaptions precisa de permissão para adicionar a Fotos. Você pode permitir em Ajustes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenCaptions ha bisogno del permesso per aggiungere a Foto. Puoi concederlo in Impostazioni."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenCaptions нужно разрешение на добавление в «Фото». Его можно дать в «Настройках»."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenCaptions'ın Fotoğraflar'a eklemek için izne ihtiyacı var. Ayarlar'dan izin verebilirsiniz."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真に追加するにはOpenCaptionsの許可が必要です。設定で許可できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenCaptions가 사진에 추가하려면 권한이 필요합니다. 설정에서 허용할 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenCaptions 需要权限才能添加到“照片”。您可以在“设置”中允许。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenCaptions memerlukan izin untuk menambahkan ke Foto. Anda dapat mengizinkannya di Pengaturan."
          }
        }
      }
    },
