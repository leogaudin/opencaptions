    "There is not enough room: this needs about %@ and the phone has %@ free. Choose a smaller size or frame rate, or free up space.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il n’y a pas assez de place : il faut environ %@ et le téléphone dispose de %@. Choisissez une taille ou une cadence plus petite, ou libérez de l’espace."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay espacio suficiente: se necesitan unos %@ y el teléfono tiene %@ libres. Elige un tamaño o una velocidad menor, o libera espacio."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht genug Platz: Es werden etwa %@ benötigt, das Telefon hat %@ frei. Wähle eine kleinere Größe oder Bildrate oder schaffe Platz."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Za mało miejsca: potrzeba około %@, a telefon ma wolne %@. Wybierz mniejszy rozmiar lub liczbę klatek albo zwolnij miejsce."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não há espaço suficiente: são necessários cerca de %@ e o celular tem %@ livres. Escolha um tamanho ou taxa de quadros menor, ou libere espaço."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Spazio insufficiente: servono circa %@ e il telefono ne ha %@ liberi. Scegli una dimensione o una frequenza minore, oppure libera spazio."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не хватает места: нужно около %@, а на телефоне свободно %@. Выберите меньший размер или частоту кадров либо освободите место."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeterli yer yok: yaklaşık %@ gerekiyor, telefonda %@ boş. Daha küçük bir boyut veya kare hızı seçin ya da yer açın."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "空き容量が足りません。約%@必要ですが、空きは%@です。サイズやフレームレートを下げるか、空き容量を増やしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "공간이 부족합니다. 약 %@가 필요하지만 휴대폰의 여유 공간은 %@입니다. 더 작은 크기나 프레임 속도를 고르거나 공간을 확보하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "空间不足：需要约 %@，手机仅剩 %@。请选择更小的尺寸或帧率，或释放空间。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ruang tidak cukup: dibutuhkan sekitar %@ dan ponsel hanya punya %@ kosong. Pilih ukuran atau kecepatan bingkai yang lebih kecil, atau kosongkan ruang."
          }
        }
      }
    },
    "This replaces the current captions, including your edits.": {
