    "You are on cellular or a hotspot. A Wi‑Fi connection would avoid using your data.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous êtes en données mobiles ou sur un point d’accès. Une connexion Wi‑Fi éviterait d’utiliser vos données."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estás con datos móviles o en un punto de acceso. Una conexión Wi‑Fi evitaría gastar tus datos."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du nutzt Mobilfunk oder einen Hotspot. Mit WLAN würden deine Daten geschont."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Korzystasz z sieci komórkowej lub hotspotu. Wi‑Fi oszczędziłoby Twoje dane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você está em dados móveis ou em um ponto de acesso. Uma conexão Wi‑Fi evitaria gastar seus dados."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sei su rete cellulare o hotspot. Una connessione Wi‑Fi eviterebbe di consumare i tuoi dati."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы используете мобильную сеть или точку доступа. Wi‑Fi позволил бы не тратить трафик."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mobil veri veya erişim noktası kullanıyorsunuz. Wi‑Fi verinizi harcamamanızı sağlar."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "モバイル通信またはテザリング中です。Wi‑Fiならデータ通信量を使いません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모바일 데이터나 핫스팟을 사용 중입니다. Wi‑Fi를 사용하면 데이터를 아낄 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您正在使用蜂窝网络或热点。使用 Wi‑Fi 可以节省流量。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda memakai data seluler atau hotspot. Koneksi Wi‑Fi akan menghemat kuota Anda."
          }
        }
      }
    },
    "Your projects are kept. Saving a project again makes its video again.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos projets sont conservés. Enregistrer à nouveau un projet recrée sa vidéo."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus proyectos se conservan. Al guardar de nuevo un proyecto se vuelve a crear su vídeo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Projekte bleiben erhalten. Beim erneuten Sichern eines Projekts wird sein Video neu erstellt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje projekty zostają. Ponowny zapis projektu tworzy jego wideo od nowa."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seus projetos são mantidos. Salvar um projeto de novo refaz o vídeo dele."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tuoi progetti restano. Salvando di nuovo un progetto si rifà il suo video."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваши проекты сохраняются. Повторное сохранение проекта создаёт его видео заново."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Projeleriniz saklanır. Bir projeyi yeniden kaydetmek videosunu yeniden oluşturur."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロジェクトは残ります。もう一度保存すると動画が作り直されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "프로젝트는 유지됩니다. 프로젝트를 다시 저장하면 동영상이 다시 만들어집니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您的项目会保留。再次保存项目会重新生成其视频。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Proyek Anda tetap ada. Menyimpan proyek lagi akan membuat ulang videonya."
          }
        }
      }
    },
