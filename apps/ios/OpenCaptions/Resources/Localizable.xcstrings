          "stringUnit": {
            "state": "translated",
            "value": "Отправляется только звук, на %@, который удалит его по завершении."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca ses, işi bitince silen %@ sunucusuna gönderilir."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音声のみが%@に送信され、処理後に削除されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오디오만 %@(으)로 전송되며 완료되면 삭제됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅发送音频到 %@，完成后即删除。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya audio yang dikirim, ke %@, yang menghapusnya setelah selesai."
          }
        }
      }
    },
