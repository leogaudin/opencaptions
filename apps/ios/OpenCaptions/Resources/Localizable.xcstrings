    "Downloaded once (%lld MB), then runs on this device. Larger models are slower and more accurate, and the biggest need a recent iPhone.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Téléchargé une fois (%lld Mo), puis fonctionne sur cet appareil. Les gros modèles sont plus lents et plus précis, et les plus gros demandent un iPhone récent."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se descarga una vez (%lld MB) y luego se ejecuta en este dispositivo. Los modelos grandes son más lentos y precisos, y los mayores necesitan un iPhone reciente."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird einmal geladen (%lld MB) und läuft dann auf diesem Gerät. Größere Modelle sind langsamer und genauer, die größten brauchen ein aktuelles iPhone."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pobierany raz (%lld MB), potem działa na tym urządzeniu. Większe modele są wolniejsze i dokładniejsze, a największe wymagają nowego iPhone’a."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Baixado uma vez (%lld MB), depois roda neste dispositivo. Modelos maiores são mais lentos e precisos, e os maiores exigem um iPhone recente."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scaricato una volta (%lld MB), poi gira su questo dispositivo. I modelli più grandi sono più lenti e precisi, e i maggiori richiedono un iPhone recente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Скачивается один раз (%lld МБ), затем работает на этом устройстве. Большие модели медленнее и точнее, а самым большим нужен новый iPhone."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir kez indirilir (%lld MB), sonra bu cihazda çalışır. Büyük modeller daha yavaş ve daha doğrudur; en büyükleri yeni bir iPhone gerektirir."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一度ダウンロード（%lld MB）すると、このデバイスで動作します。大きいモデルほど遅く正確で、最大のものは新しいiPhoneが必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 번 다운로드(%lld MB)하면 이 기기에서 실행됩니다. 큰 모델일수록 느리지만 정확하며, 가장 큰 모델은 최신 iPhone이 필요합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只需下载一次（%lld MB），之后在此设备上运行。模型越大越慢但越准确，最大的模型需要较新的 iPhone。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Diunduh sekali (%lld MB), lalu berjalan di perangkat ini. Model yang lebih besar lebih lambat dan akurat, dan yang terbesar memerlukan iPhone terbaru."
          }
        }
      }
    },
