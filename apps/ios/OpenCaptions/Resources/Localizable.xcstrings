    "It frees %@ and downloads again when you next choose it.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela libère %@ ; il se télécharge à nouveau au prochain choix."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Libera %@ y se vuelve a descargar la próxima vez que lo elijas."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das gibt %@ frei; beim nächsten Auswählen wird es erneut geladen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zwalnia %@ i pobiera się ponownie przy następnym wyborze."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Libera %@ e baixa de novo na próxima vez que você o escolher."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Libera %@ e si scarica di nuovo alla prossima scelta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Освобождает %@ и скачивается заново при следующем выборе."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ yer açar ve bir dahaki seçişinizde yeniden indirilir."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@の空きができ、次に選ぶと再ダウンロードされます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@의 공간을 확보하며, 다음에 선택하면 다시 다운로드됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可释放 %@，下次选择时会重新下载。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Membebaskan %@ dan diunduh lagi saat Anda memilihnya berikutnya."
          }
        }
      }
    },
    "Just this time. Settings keeps your usual choice.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette fois seulement. Les Réglages gardent votre choix habituel."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo esta vez. Los Ajustes conservan tu elección habitual."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur diesmal. Die Einstellungen behalten deine übliche Wahl."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tylko tym razem. Ustawienia zachowują Twój zwykły wybór."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Só desta vez. Os Ajustes guardam sua escolha de sempre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo questa volta. Le Impostazioni mantengono la tua scelta abituale."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Только в этот раз. В «Настройках» остаётся ваш обычный выбор."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca bu seferlik. Ayarlar olağan seçiminizi korur."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今回だけです。設定には普段の選択が残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이번만 적용됩니다. 설정에는 평소 선택이 유지됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
