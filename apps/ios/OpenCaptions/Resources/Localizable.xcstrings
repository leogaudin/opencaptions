      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il n’y a pas assez de place : il faut environ %@ et le téléphone dispose de %@. Choisissez une taille ou une cadence plus petite, ou libérez de l’espace."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay espacio suficiente: se necesitan unos %@ y el teléfono tiene %@ libres. Elige un tamaño o una velocidad menor, o libera espacio."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht genug Platz: Es werden etwa %@ benötigt, das Telefon hat %@ frei. Wähle eine kleinere Größe oder Bildrate oder schaffe Platz."
          }
        }
      }
    },
