    "Adding the captions to your video. Keep OpenCaptions open until it finishes.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajout des sous-titres à votre vidéo. Gardez OpenCaptions ouvert jusqu’à la fin."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añadiendo los subtítulos a tu vídeo. Mantén OpenCaptions abierta hasta que termine."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Untertitel werden zu deinem Video hinzugefügt. Lass OpenCaptions geöffnet, bis es fertig ist."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodawanie napisów do wideo. Pozostaw OpenCaptions otwarte do zakończenia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicionando as legendas ao seu vídeo. Mantenha o OpenCaptions aberto até terminar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiunta dei sottotitoli al video. Tieni OpenCaptions aperto fino al termine."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавление субтитров к видео. Держите OpenCaptions открытым до завершения."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Altyazılar videonuza ekleniyor. Bitene kadar OpenCaptions'ı açık tutun."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "動画に字幕を追加しています。完了するまでOpenCaptionsを開いたままにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "동영상에 자막을 추가하는 중입니다. 끝날 때까지 OpenCaptions를 열어 두세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在为视频添加字幕。请保持 OpenCaptions 打开，直到完成。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menambahkan teks ke video Anda. Biarkan OpenCaptions terbuka sampai selesai."
          }
        }
      }
    },
    "An ordinary video that looks right everywhere, including where HDR is not supported.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une vidéo ordinaire qui s’affiche bien partout, y compris là où le HDR n’est pas pris en charge."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un vídeo normal que se ve bien en todas partes, incluso donde no se admite HDR."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein gewöhnliches Video, das überall gut aussieht, auch wo HDR nicht unterstützt wird."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zwykłe wideo, które dobrze wygląda wszędzie, także tam, gdzie HDR nie jest obsługiwany."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um vídeo comum que fica bom em qualquer lugar, inclusive onde não há suporte a HDR."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un video normale che si vede bene ovunque, anche dove l’HDR non è supportato."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обычное видео, которое хорошо выглядит везде, в том числе там, где HDR не поддерживается."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "HDR'nin desteklenmediği yerler dahil her yerde doğru görünen sıradan bir video."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "HDR非対応の環境を含め、どこでも正しく表示される通常の動画です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "HDR을 지원하지 않는 곳을 포함해 어디서나 올바르게 보이는 일반 동영상입니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "普通视频，在任何地方（包括不支持 HDR 的地方）都能正常显示。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Video biasa yang tampil benar di mana saja, termasuk di tempat yang tidak mendukung HDR."
          }
        }
      }
    },
