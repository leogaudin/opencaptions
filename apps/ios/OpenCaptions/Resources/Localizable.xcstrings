    "The picture stays as filmed; the captions animate at %lld fps, smoother.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’image reste telle que filmée ; les sous-titres s’animent à %lld i/s, plus fluides."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La imagen se queda como se grabó; los subtítulos se animan a %lld fps, más suaves."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Bild bleibt wie gefilmt; die Untertitel werden mit %lld Bildern pro Sekunde animiert, flüssiger."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Obraz pozostaje taki, jak nagrany; napisy animują się w %lld kl./s, płynniej."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A imagem fica como foi gravada; as legendas animam a %lld fps, mais suaves."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’immagine resta come girata; i sottotitoli si animano a %lld fps, più fluidi."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Картинка остаётся как снята; субтитры анимируются при %lld к/с, плавнее."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Görüntü çekildiği gibi kalır; altyazılar %lld kare/sn ile daha akıcı hareket eder."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "映像は撮影時のまま。字幕は%lld fpsでなめらかに動きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "영상은 촬영된 그대로이고, 자막은 %lld fps로 더 부드럽게 움직입니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "画面保持拍摄时的样子；字幕以 %lld 帧/秒动画，更流畅。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Gambar tetap seperti saat direkam; teks beranimasi pada %lld fps, lebih halus."
          }
        }
      }
    },
