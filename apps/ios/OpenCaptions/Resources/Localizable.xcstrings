    "The audio of a video is sent to %@ to be transcribed, and deleted there afterwards.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’audio d’une vidéo est envoyé à %@ pour être transcrit, puis supprimé là-bas."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El audio de un vídeo se envía a %@ para transcribirlo y después se elimina allí."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Ton eines Videos wird zur Transkription an %@ gesendet und dort danach gelöscht."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dźwięk wideo jest wysyłany do %@ w celu transkrypcji, a potem tam usuwany."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O áudio de um vídeo é enviado para %@ para ser transcrito e depois apagado lá."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’audio di un video viene inviato a %@ per la trascrizione e poi eliminato lì."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Звук видео отправляется на %@ для расшифровки, а затем удаляется там."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir videonun sesi çevrilmek üzere %@ sunucusuna gönderilir ve sonra orada silinir."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "動画の音声は文字起こしのため%@に送信され、その後そこで削除されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "동영상의 오디오가 받아쓰기를 위해 %@(으)로 전송되고, 이후 그곳에서 삭제됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "视频的音频会发送到 %@ 进行转写，之后在那里删除。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio video dikirim ke %@ untuk ditranskripsi, lalu dihapus di sana."
          }
        }
      }
    },
    "The audio of your videos will be sent to %@ to be transcribed there. Only continue if you trust it.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’audio de vos vidéos sera envoyé à %@ pour y être transcrit. Ne continuez que si vous lui faites confiance."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El audio de tus vídeos se enviará a %@ para transcribirlo allí. Continúa solo si confías en él."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Ton deiner Videos wird zur Transkription an %@ gesendet. Fahre nur fort, wenn du ihm vertraust."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dźwięk Twoich wideo zostanie wysłany do %@ w celu transkrypcji. Kontynuuj tylko, jeśli mu ufasz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O áudio dos seus vídeos será enviado para %@ para ser transcrito lá. Continue apenas se confiar nele."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’audio dei tuoi video verrà inviato a %@ per essere trascritto lì. Continua solo se ti fidi."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Звук ваших видео будет отправлен на %@ для расшифровки там. Продолжайте, только если доверяете ему."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Videolarınızın sesi orada çevrilmek üzere %@ sunucusuna gönderilecek. Yalnızca ona güveniyorsanız devam edin."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "動画の音声は文字起こしのため%@に送信されます。信頼できる場合のみ続行してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "동영상의 오디오가 받아쓰기를 위해 %@(으)로 전송됩니다. 신뢰하는 경우에만 계속하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您视频的音频将发送到 %@ 并在那里转写。仅在信任它时才继续。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio video Anda akan dikirim ke %@ untuk ditranskripsi di sana. Lanjutkan hanya jika Anda memercayainya."
          }
        }
      }
    },
