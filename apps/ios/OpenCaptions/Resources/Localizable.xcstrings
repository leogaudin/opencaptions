    "Choose “Remote server” to transcribe on another OpenCaptions server instead, which is faster on a computer with a graphics card.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez « Serveur distant » pour transcrire sur un autre serveur OpenCaptions, plus rapide sur un ordinateur doté d’une carte graphique."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige «Servidor remoto» para transcribir en otro servidor OpenCaptions, más rápido en un ordenador con tarjeta gráfica."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle „Entfernter Server“, um auf einem anderen OpenCaptions-Server zu transkribieren, was auf einem Computer mit Grafikkarte schneller geht."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz „Zdalny serwer”, aby transkrybować na innym serwerze OpenCaptions, co jest szybsze na komputerze z kartą graficzną."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha “Servidor remoto” para transcrever em outro servidor OpenCaptions, mais rápido em um computador com placa de vídeo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli «Server remoto» per trascrivere su un altro server OpenCaptions, più veloce su un computer con scheda grafica."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите «Удалённый сервер», чтобы расшифровывать на другом сервере OpenCaptions, что быстрее на компьютере с видеокартой."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Başka bir OpenCaptions sunucusunda çeviriyazı yapmak için “Uzak sunucu”yu seçin; ekran kartlı bir bilgisayarda daha hızlıdır."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「リモートサーバー」を選ぶと別のOpenCaptionsサーバーで文字起こしします。グラフィックスカード搭載のPCなら高速です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“원격 서버”를 선택하면 다른 OpenCaptions 서버에서 받아쓰기를 합니다. 그래픽 카드가 있는 컴퓨터에서 더 빠릅니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择“远程服务器”可在另一台 OpenCaptions 服务器上转写，在配有显卡的电脑上更快。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih “Server jarak jauh” untuk bertranskripsi di server OpenCaptions lain, lebih cepat di komputer dengan kartu grafis."
          }
        }
      }
    },
