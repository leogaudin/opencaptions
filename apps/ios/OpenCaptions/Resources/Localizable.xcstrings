    "About": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Environ"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aprox."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Etwa"
          }
        }
      }
    },
    "About a third smaller. Plays on recent phones and computers, not on some old players and sites.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Environ un tiers plus petit. Compatible avec les téléphones et ordinateurs récents, pas avec certains anciens lecteurs et sites."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aproximadamente un tercio más pequeño. Se reproduce en teléfonos y ordenadores recientes, no en algunos reproductores y sitios antiguos."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Etwa ein Drittel kleiner. Läuft auf aktuellen Telefonen und Computern, nicht auf manchen alten Playern und Websites."
          }
        }
      }
    },
    "Add captions that move": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez des sous-titres animés"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade subtítulos con movimiento"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge bewegte Untertitel hinzu"
          }
        }
      }
    },
    "Adding the captions to your video. Keep OpenCaptions open until it finishes.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajout des sous-titres à votre vidéo. Gardez OpenCaptions ouvert jusqu’à la fin."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añadiendo los subtítulos a tu vídeo. Mantén OpenCaptions abierta hasta que termine."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Untertitel werden zu deinem Video hinzugefügt. Lass OpenCaptions geöffnet, bis es fertig ist."
          }
        }
      }
    },
    "An ordinary video that looks right everywhere, including where HDR is not supported.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une vidéo ordinaire qui s’affiche bien partout, y compris là où le HDR n’est pas pris en charge."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un vídeo normal que se ve bien en todas partes, incluso donde no se admite HDR."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein gewöhnliches Video, das überall gut aussieht, auch wo HDR nicht unterstützt wird."
          }
        }
      }
    },
