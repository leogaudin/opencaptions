    "The Large v3 speech model": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le modèle vocal Large v3"
          }
        },
        "es": {
          "stringUnit": {
