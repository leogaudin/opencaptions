    "In the server's web app, open Account and create a key: it comes with a link. Paste the link here, or enter the address and the key.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans l’app web du serveur, ouvrez Compte et créez une clé : elle est fournie avec un lien. Collez le lien ici, ou saisissez l’adresse et la clé."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En la app web del servidor, abre Cuenta y crea una clave: incluye un enlace. Pega el enlace aquí, o introduce la dirección y la clave."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne in der Web-App des Servers „Konto“ und erstelle einen Schlüssel: Er kommt mit einem Link. Füge den Link hier ein oder gib die Adresse und den Schlüssel ein."
          }
        }
      }
    },
    "It could not be saved": {
      "extractionState": "manual",
