          }
        }
      }
    },
    "The model could not be downloaded: %@": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le modèle n’a pas pu être téléchargé : %@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo descargar el modelo: %@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Modell konnte nicht geladen werden: %@"
          }
        }
      }
    },
    "The picture stays as filmed; the captions animate at %lld fps, smoother.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’image reste telle que filmée ; les sous-titres s’animent à %lld i/s, plus fluides."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La imagen se queda como se grabó; los subtítulos se animan a %lld fps, más suaves."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Bild bleibt wie gefilmt; die Untertitel werden mit %lld Bildern pro Sekunde animiert, flüssiger."
          }
        }
      }
    },
    "The save stopped because OpenCaptions left the screen. Keep it open while it saves, then try again.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’enregistrement s’est arrêté car OpenCaptions a quitté l’écran. Gardez l’app ouverte pendant l’enregistrement, puis réessayez."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El guardado se detuvo porque OpenCaptions salió de la pantalla. Mantenla abierta mientras guarda e inténtalo de nuevo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Sichern wurde abgebrochen, weil OpenCaptions den Bildschirm verlassen hat. Lass die App beim Sichern geöffnet und versuche es erneut."
          }
        }
      }
    },
    "The server chooses the model.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur choisit le modèle."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servidor elige el modelo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server wählt das Modell."
          }
        }
      }
    },
    "The video and its captions are removed from this device.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La vidéo et ses sous-titres sont supprimés de cet appareil."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El vídeo y sus subtítulos se eliminan de este dispositivo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Video und seine Untertitel werden von diesem Gerät entfernt."
          }
        }
      }
    },
