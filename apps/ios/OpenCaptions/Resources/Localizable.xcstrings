    "Captions that move, made on your phone. Nothing is uploaded: the speech is transcribed on this device.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Des sous-titres animés, créés sur votre téléphone. Rien n’est envoyé : la parole est transcrite sur cet appareil."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Subtítulos con movimiento, hechos en tu teléfono. No se sube nada: la voz se transcribe en este dispositivo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bewegte Untertitel, auf deinem Telefon erstellt. Es wird nichts hochgeladen: Die Sprache wird auf diesem Gerät transkribiert."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ruchome napisy, tworzone na telefonie. Nic nie jest przesyłane: mowa jest transkrybowana na tym urządzeniu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Legendas animadas, feitas no seu celular. Nada é enviado: a fala é transcrita neste dispositivo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sottotitoli animati, creati sul tuo telefono. Non viene caricato nulla: il parlato è trascritto su questo dispositivo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Анимированные субтитры, созданные на телефоне. Ничего не загружается: речь расшифровывается на этом устройстве."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefonunuzda yapılan hareketli altyazılar. Hiçbir şey yüklenmez: konuşma bu cihazda çevrilir."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スマートフォンで作る動く字幕。何もアップロードされず、音声はこのデバイス上で文字起こしされます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "휴대폰에서 만드는 움직이는 자막. 아무것도 업로드되지 않으며, 음성은 이 기기에서 받아쓰기됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在手机上制作会动的字幕。不会上传任何内容：语音在此设备上转写。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Teks yang bergerak, dibuat di ponsel Anda. Tidak ada yang diunggah: ucapan ditranskripsi di perangkat ini."
          }
        }
      }
    },
