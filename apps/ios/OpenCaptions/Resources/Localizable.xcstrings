    "The save stopped because OpenCaptions left the screen. Keep it open while it saves, then try again.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’enregistrement s’est arrêté car OpenCaptions a quitté l’écran. Gardez l’app ouverte pendant l’enregistrement, puis réessayez."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El guardado se detuvo porque OpenCaptions salió de la pantalla. Mantenla abierta mientras guarda e inténtalo de nuevo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Sichern wurde abgebrochen, weil OpenCaptions den Bildschirm verlassen hat. Lass die App beim Sichern geöffnet und versuche es erneut."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapis został przerwany, bo OpenCaptions opuściło ekran. Pozostaw aplikację otwartą podczas zapisu i spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O salvamento parou porque o OpenCaptions saiu da tela. Mantenha o app aberto enquanto salva e tente de novo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il salvataggio si è interrotto perché OpenCaptions ha lasciato lo schermo. Tieni l’app aperta durante il salvataggio e riprova."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохранение прервалось, потому что OpenCaptions покинуло экран. Держите приложение открытым во время сохранения и повторите."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenCaptions ekrandan çıktığı için kaydetme durdu. Kaydederken uygulamayı açık tutun ve tekrar deneyin."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenCaptionsが画面から離れたため保存が中断されました。保存中はアプリを開いたままにして、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenCaptions가 화면을 벗어나 저장이 중단되었습니다. 저장하는 동안 앱을 열어 두고 다시 시도하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "由于 OpenCaptions 离开了屏幕，保存已中断。保存时请保持应用打开，然后重试。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Penyimpanan berhenti karena OpenCaptions meninggalkan layar. Biarkan aplikasi terbuka saat menyimpan, lalu coba lagi."
          }
        }
      }
    },
