    "Keeps the full brightness and colour of the original. Saved as HEVC.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Conserve toute la luminosité et les couleurs de l’original. Enregistré en HEVC."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conserva todo el brillo y el color del original. Se guarda en HEVC."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Behält die volle Helligkeit und Farbe des Originals. Wird als HEVC gesichert."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zachowuje pełną jasność i kolory oryginału. Zapis jako HEVC."
          }
        },
        "pt-BR": {
