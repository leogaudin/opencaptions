<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- What the generated Info.plist cannot express; Xcode merges it with the generated keys. -->
<plist version="1.0">
<dict>
	<!-- The languages the app is translated into (its string catalogs). -->
	<key>CFBundleLocalizations</key>
	<array>
		<string>en</string>
		<string>fr</string>
		<string>es</string>
		<string>de</string>
		<string>pl</string>
		<string>pt-BR</string>
		<string>it</string>
		<string>ru</string>
		<string>tr</string>
		<string>ja</string>
		<string>ko</string>
		<string>zh-Hans</string>
		<string>id</string>
	</array>
	<!-- opencaptions://connect?url=…&key=… : the link the web app makes to pair this app with a server. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>org.leogaudin.opencaptions</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>opencaptions</string>
			</array>
		</dict>
	</array>
	<!-- Only HTTPS and the system's own encryption: nothing for export compliance to ask about. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- A server on the local network (a GPU box at home) is plain http; nothing else is allowed to be. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Reaches an OpenCaptions server on your network to transcribe your videos there.</string>
</dict>
</plist>
