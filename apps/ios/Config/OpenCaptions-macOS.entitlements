<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The Mac App Store needs the sandbox. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- A video the user picks, or drops on the window, and where they save the captioned one. -->
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<!-- Model downloads, and the user's own OpenCaptions server if they set one. -->
	<key>com.apple.security.network.client</key>
	<true/>
	<!-- "Save to Photos" after an export. -->
	<key>com.apple.security.personal-information.photos-library</key>
	<true/>
</dict>
</plist>
