    "Could not reach %@. Check the address and your connection.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de joindre %@. Vérifiez l’adresse et votre connexion."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo conectar con %@. Comprueba la dirección y tu conexión."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ist nicht erreichbar. Prüfe die Adresse und deine Verbindung."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można połączyć się z %@. Sprawdź adres i połączenie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível alcançar %@. Verifique o endereço e sua conexão."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile raggiungere %@. Controlla l’indirizzo e la connessione."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось связаться с %@. Проверьте адрес и соединение."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ sunucusuna ulaşılamadı. Adresi ve bağlantınızı kontrol edin."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@に接続できません。アドレスと接続を確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@에 연결할 수 없습니다. 주소와 연결을 확인하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法连接到 %@。请检查地址和网络。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak dapat menjangkau %@. Periksa alamat dan koneksi Anda."
          }
        }
      }
    },
