{
  "sourceLanguage": "en",
  "strings": {
    "Checking for missed speech (%lld of %lld)…": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Recherche de paroles manquées (%lld sur %lld)…"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Buscando voz omitida (%lld de %lld)…"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Suche nach übersehener Sprache (%lld von %lld) …"
          }
        }
      }
    },
    "Could not reach %@. Check the address and your connection.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de joindre %@. Vérifiez l’adresse et votre connexion."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo conectar con %@. Comprueba la dirección y tu conexión."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ist nicht erreichbar. Prüfe die Adresse und deine Verbindung."
          }
        }
      }
    },
    "Detecting the language…": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Détection de la langue…"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Detectando el idioma…"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprache wird erkannt …"
          }
        }
      }
    },
    "Done": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Terminé"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hecho"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fertig"
          }
        }
      }
    },
    "It stopped making progress, so it was stopped. Please try again.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’opération ne progressait plus, elle a donc été arrêtée. Veuillez réessayer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dejó de avanzar, así que se detuvo. Inténtalo de nuevo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es kam nicht mehr voran und wurde deshalb beendet. Bitte versuche es erneut."
          }
        }
      }
    },
    "Loading the model into memory…": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chargement du modèle en mémoire…"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cargando el modelo en memoria…"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Modell wird in den Speicher geladen …"
          }
        }
      }
    },
    "No speech was found in this video.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune parole n’a été trouvée dans cette vidéo."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se encontró voz en este vídeo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In diesem Video wurde keine Sprache gefunden."
          }
        }
      }
    },
    "Preparing the audio…": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
