          "stringUnit": {
            "state": "translated",
            "value": "Iniciando…"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird gestartet …"
          }
        }
      }
    },
    "The %@ model has not been downloaded.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le modèle %@ n’a pas été téléchargé."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El modelo %@ no se ha descargado."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Modell %@ wurde nicht heruntergeladen."
          }
        }
      }
    },
    "The server could not transcribe it: %@": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur n’a pas pu le transcrire : %@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servidor no pudo transcribirlo: %@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server konnte es nicht transkribieren: %@"
          }
        }
      }
    },
    "The server did not accept the key. It may have been revoked: make a new one.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur n’a pas accepté la clé. Elle a peut-être été révoquée : créez-en une nouvelle."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servidor no aceptó la clave. Puede que se haya revocado: crea una nueva."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server hat den Schlüssel nicht akzeptiert. Möglicherweise wurde er widerrufen: Erstelle einen neuen."
          }
        }
      }
    },
    "The server speaks transcription version %lld, and this app speaks %lld. Update the older one.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur utilise la version %lld de la transcription et cette app la version %lld. Mettez à jour la plus ancienne."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servidor usa la versión %lld de la transcripción y esta app la %lld. Actualiza la más antigua."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server nutzt Transkriptionsversion %lld, diese App Version %lld. Aktualisiere die ältere."
          }
        }
      }
    },
    "The video could not be saved: %@": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
