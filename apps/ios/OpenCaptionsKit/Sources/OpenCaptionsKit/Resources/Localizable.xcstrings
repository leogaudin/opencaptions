    "It stopped making progress, so it was stopped. Please try again.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’opération ne progressait plus, elle a donc été arrêtée. Veuillez réessayer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dejó de avanzar, así que se detuvo. Inténtalo de nuevo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es kam nicht mehr voran und wurde deshalb beendet. Bitte versuche es erneut."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przestało postępować, więc je zatrzymano. Spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Parou de avançar e foi interrompido. Tente novamente."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non progrediva più ed è stato interrotto. Riprova."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Процесс перестал продвигаться и был остановлен. Повторите попытку."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İlerlemeyi durdurdu ve bu yüzden durduruldu. Lütfen tekrar deneyin."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "進行が止まったため中断しました。もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "진행이 멈춰 중단되었습니다. 다시 시도하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "进度停滞，已被中止。请重试。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Prosesnya berhenti maju sehingga dihentikan. Silakan coba lagi."
          }
        }
      }
    },
    "Loading the model… the first time on this phone can take a few minutes.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chargement du modèle… la première fois sur ce téléphone, cela peut prendre quelques minutes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cargando el modelo… la primera vez en este teléfono puede tardar unos minutos."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Modell wird geladen … beim ersten Mal auf diesem Telefon kann es einige Minuten dauern."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ładowanie modelu… za pierwszym razem na tym telefonie może to potrwać kilka minut."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Carregando o modelo… na primeira vez neste celular pode levar alguns minutos."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Caricamento del modello… la prima volta su questo telefono può richiedere qualche minuto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "モデルを読み込み中… この端末での初回は数分かかることがあります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모델을 불러오는 중… 이 휴대폰에서 처음에는 몇 분이 걸릴 수 있습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Загрузка модели… в первый раз на этом телефоне это может занять несколько минут."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Model yükleniyor… bu telefonda ilk seferde birkaç dakika sürebilir."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Memuat model… pertama kali di ponsel ini bisa memakan waktu beberapa menit."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在加载模型… 在这部手机上首次加载可能需要几分钟。"
          }
        }
      }
    },
