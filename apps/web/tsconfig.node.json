{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "strict": true,
    "composite": true,
    "emitDeclarationOnly": true,
    // The unit tests run on Node's own TypeScript support, which wants the extension.
    "allowImportingTsExtensions": true,
    "outDir": "node_modules/.tmp/tsc-node",
    "allowSyntheticDefaultImports": true,
    "isolatedModules": true,
    "types": ["node"],
    // The client under test imports the app's types through the `@/` alias, and the types read presets.json.
    "paths": { "@/*": ["./src/*"] },
    "resolveJsonModule": true
  },
  "include": [
    "vite.config.ts",
    "vite.demo.config.ts",
    "scripts/demo-prerender.ts",
    "playwright.config.ts",
    "tests/**/*.ts",
    "src/demo/links.ts",
    "src/lib/api.ts",
    "src/lib/autosave.ts",
    "src/lib/transcriptionLanguages.ts",
    "src/lib/fontManifest.ts",
    "src/lib/history.ts",
    "src/lib/tileSample.ts",
    "src/lib/transcriptText.ts",
    "src/lib/presets.json",
    "src/types/*.ts"
  ]
}
