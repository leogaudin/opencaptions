{
  "name": "@opencaptions/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "description": "OpenCaptions web frontend",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "dev:demo": "vite -c vite.demo.config.ts",
    "build:demo": "tsc -b && vite build -c vite.demo.config.ts && mv dist-demo/demo.html dist-demo/index.html",
    "preview:demo": "vite preview -c vite.demo.config.ts --port 5174",
    "lint": "biome check src/ tests/",
    "format": "biome format --write src/ tests/",
    "typecheck": "tsc -b --pretty false",
    "test": "node --test \"tests/unit/**/*.test.ts\"",
    "test:e2e": "playwright test",
    "generate-types": "bash ../../scripts/generate-api-types.sh"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.0",
    "@radix-ui/react-dropdown-menu": "^2.1.0",
    "clsx": "^2.1.0",
    "lucide-react": "^1.50.0",
    "qrcode-generator": "2.0.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-dropzone": "^20.1.2",
    "react-resizable-panels": "^4.14.1",
    "react-router-dom": "^7.18.4",
    "tailwind-merge": "^3.7.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@playwright/test": "^1.49.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "openapi-typescript": "^7.13.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.2"
  }
}
